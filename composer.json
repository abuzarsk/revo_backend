{
    "name": "your-vendor/your-project",
    "description": "PHP MVC Framework Project",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.11",
        "google/apiclient": "^2.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
